{
  "name": "dokterpanggil-site",
  "version": "1.0.0",
  "private": true,
  "description": "DokterPanggil.id static website",
  "scripts": {
    "build:pages": "node tools/build-seo.js",
    "build:css": "tailwindcss -i ./src/tailwind.input.css -o ./assets/css/tailwind.css --minify",
    "build": "npm run build:pages && npm run build:css",
    "watch:css": "tailwindcss -i ./src/tailwind.input.css -o ./assets/css/tailwind.css --watch",
    "verify": "node tools/verify-seo.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
